# 기본: 텍스트는 저장소에 LF로 보관, 체크아웃 시 OS 기본값
* text=auto

# 셸 스크립트는 LF 유지 — CRLF가 섞이면 Git Bash/Linux에서 실행되지 않는다
*.sh    text eol=lf
gradlew text eol=lf

# Windows 배치 파일은 CRLF 유지
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 바이너리 — 변환 금지
*.jar   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.exe   binary
